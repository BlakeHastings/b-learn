<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>blearn</AssemblyName>
    <RootNamespace>BLearn.Cli</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="index.html" LogicalName="BLearn.Cli.index.html" />
    <Content Remove="index.html" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig" Version="1.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BLearn.Core\BLearn.Core.csproj" />
  </ItemGroup>

</Project>
